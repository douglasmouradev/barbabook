# BarbaBook - Exemplo de variáveis de ambiente
# Copie para .env e ajuste (ou configure direto em config/database.php)

DB_HOST=localhost
DB_PORT=3306
DB_NAME=barbabook
DB_USER=barbabook
DB_PASS=sua_senha_segura

